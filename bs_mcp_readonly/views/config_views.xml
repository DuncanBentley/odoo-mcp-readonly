<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bs_mcp_readonly_config_form" model="ir.ui.view">
        <field name="name">bs.mcp.readonly.config.form</field>
        <field name="model">bs.mcp.readonly.config</field>
        <field name="arch" type="xml">
            <form string="MCP Connector Read-only">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="max_records"/>
                        </group>
                        <group>
                            <field name="allowed_model_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Endpoint: POST /mcp/readonly with the header Authorization: Bearer (an Odoo API key).
                        Create the key in your user preferences, Account Security tab. This connector can only read.
                    </div>
                    <div class="text-muted">
                        <field name="info" readonly="1" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bs_mcp_readonly_config_action" model="ir.actions.act_window">
        <field name="name">MCP Connector Read-only</field>
        <field name="res_model">bs.mcp.readonly.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="bs_mcp_readonly_menu" name="MCP Connector Read-only" parent="base.menu_administration"
              action="bs_mcp_readonly_config_action" groups="base.group_system" sequence="90"/>
</odoo>
